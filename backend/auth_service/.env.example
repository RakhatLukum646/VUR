mongodb_url=mongodb://mongo:27017
mongodb_db=vur

jwt_secret=change-me-in-production
jwt_algorithm=HS256
access_token_expire_minutes=15
refresh_token_expire_days=7
password_reset_expire_minutes=30
recovery_codes_count=8

# Frontend base URL used inside emails (verify/reset links).
# Dev (Vite):
frontend_url=http://localhost:5173
cors_origins=http://localhost:5173,http://localhost
#
# If you access the site via TLS reverse proxy (example):
# frontend_url=https://localhost:4443
# cors_origins=https://localhost:4443
access_cookie_name=vur_access_token
refresh_cookie_name=vur_refresh_token
# For local Vite over http:
cookie_secure=false
cookie_samesite=lax
#
# For HTTPS (reverse proxy):
# cookie_secure=true
# cookie_samesite=none

email_host=smtp.example.com
email_port=587
email_user=noreply@example.com
email_password=change-me

log_level=INFO
